    "protocols": {
      "MV-1": "market_score 由 market_direction 自动映射（程序生成），禁止独立人工标注产生不一致（如 NEUTRAL/-1 非法）。",
      "MV-2": "direction / risk / position_bias 三轴独立，任何一轴不得反推另一轴；BEARISH+AGGRESSIVE、BULLISH+HIGH 均合法。",
      "MV-3": "direction 默认取分析师对最近 1-3 个交易日最明确的方向判断；短期与中期冲突时以短期为 direction，中期信息保留到 summary/risk。",
      "MV-4": "纯个股分析 view_scope=STOCK_ONLY → direction/risk/bias=UNKNOWN, exclude_from_market_consensus=true；不是 Parser 没看懂，是原文没有市场级观点。"
    },
    "major_reversal_error": "BULLISH→BEARISH 或 BEARISH→BULLISH 判反 = 重大错误，必须 0",
    "thresholds": {
      "direction": 0.95,
      "risk": 0.9,
      "position_bias": 0.9
    },
    "scope_note": "view_scope 决定是否进入 Market Consensus 聚合：MARKET/MIXED 纳入；STOCK_ONLY/UNKNOWN 排除（UNKNOWN 原文无观点时排除，Parser 未能分类时按 UNKNOWN 处理）。"
  },
